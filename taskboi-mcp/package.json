{
  "name": "taskboi-mcp",
  "version": "1.0.0",
  "description": "MCP server for Taskboi - AI-powered task management",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-base-url": {
      "types": "./dist/api-base-url.d.ts",
      "import": "./dist/api-base-url.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "bin": {
    "taskboi-mcp": "./bin/taskboi-mcp.js"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.js && tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "task-management",
    "taskboi",
    "claude",
    "ai"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin"
  ]
}
